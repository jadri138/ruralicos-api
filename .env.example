# ─────────────────────────────────────────────
# RURALICOS API — Variables de entorno requeridas
# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git.
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# OpenAI
OPENAI_API_KEY=sk-...
# Las tareas estructuradas con gpt-5-nano usan razonamiento minimo para reservar
# el presupuesto de salida al JSON visible (minimal por defecto).
IA_GPT5_NANO_REASONING_EFFORT=minimal
IA_GPT56_LUNA_REASONING_EFFORT=low
# Protege despliegues que aun conserven temporalmente un gpt-5 antiguo.
IA_GPT5_REASONING_EFFORT=minimal

# Decision personal usuario-alerta. El top K efectivo se limita a 1..20.
ALERT_DECISION_TOP_K=10
ALERT_DECISION_JUDGE_MODEL=gpt-5-nano
# Solo se consulta en casos de riesgo; Luna no participa en los casos claros.
ALERT_DECISION_SECOND_OPINION_MODEL=gpt-5.6-luna
# Llamadas simultaneas al juez (el codigo limita a 1..6).
ALERT_DECISION_JUDGE_CONCURRENCY=3
# Maximo diario de llamadas del juez y su segunda opinion. 0 desactiva el tope
# solo para desarrollo; produccion debe fijar un valor positivo medido. Si un
# tope activo no puede comprobarse, el sistema retiene de forma segura.
ALERT_DECISION_LLM_DAILY_CALL_LIMIT=0
# Tarifas operativas opcionales, aportadas por el equipo (no se presuponen precios).
# Formato: {"modelo":{"currency":"EUR","input_per_million":N,
# "cached_input_per_million":N,"output_per_million":N}}
# ALERT_DECISION_JUDGE_PRICING_JSON=
# Secreto largo y estable. No usar telefonos, IDs ni otros datos personales.
ALERT_DECISION_PSEUDONYM_SALT=<secreto-largo-y-estable>
# El render limita finalmente el valor al rango 800..4096.
ALERT_DECISION_MESSAGE_MAX_CHARS=3200

# Runner local manual: exige activacion temporal explicita.
SHADOW_V2_ENABLED=false
# Motor productivo. v1 conserva el flujo actual; v2 completa shadow, lo
# revalida, lo promueve a digests y reutiliza la misma cola de WhatsApp.
DIGEST_ENGINE=v1
# En V1 controla la auditoria shadow opcional al final. En V2 el motor es una
# fase obligatoria aunque esta variable sea false.
RUN_SHADOW_V2=true
SHADOW_V2_MAX_LOOPS=60
SHADOW_V2_BATCH_SIZE=25
SHADOW_V2_MAX_CALLS_PER_BATCH=25
SHADOW_V2_MAX_USERS_PER_BATCH=10
# Modelos de calidad eficiente para el producto individual. Cooperativas queda
# fuera de esta politica hasta que ese producto vuelva a estar operativo.
DIGEST_MESSAGE_MODEL=gpt-5.6-luna
MIA_GROUNDED_MODEL=gpt-5.6-luna
CRITICAL_DOUBLE_CHECK_MODEL_A=gpt-5-nano
CRITICAL_DOUBLE_CHECK_MODEL_B=gpt-5.6-luna

# Replay historico. La sal es opcional: si falta, cada exportacion usa una
# efimera. El grader no se ejecuta sin --enable y sin modelo explicito.
# REPLAY_EXPORT_SALT=<secreto-local-largo>
# REPLAY_GRADER_MODEL=<modelo-aprobado>

# Preparacion de digest: una persona por request evita superar el timeout del
# proxy cuando la seleccion requiere varias llamadas IA.
PREPARAR_DIGEST_BATCH_SIZE=1
# Numero maximo de usuarios que el workflow puede preparar, uno por peticion.
PREPARAR_DIGEST_MAX_LOOPS=200

# Maximo de lotes HOLD vencidos que vacia el unico workflow diario. Si queda
# cola, se retoma de forma idempotente al dia siguiente.
HOLD_RECOVERY_MAX_LOOPS=20

# Reintento automatico de HOLD tecnicos del juez personal. Se ejecuta dentro
# de preparar-digest, nunca en otro cron ni mediante un envio independiente.
ALERT_DECISION_HOLD_MAX_RETRIES=3
ALERT_DECISION_HOLD_RETRY_PER_USER=2
ALERT_DECISION_HOLD_RETRY_BASE_HOURS=24
ALERT_DECISION_HOLD_RETRY_MAX_HOURS=96
ALERT_DECISION_HOLD_RETRY_LEASE_MS=900000

# Avisos de volumen en salud de recomendaciones. Se compara el ultimo dia con
# la mediana de su propio historico y no se alerta sin una muestra suficiente.
RECOMMENDATION_VOLUME_BASELINE_DAYS=7
RECOMMENDATION_VOLUME_MIN_BASELINE_DAYS=5
RECOMMENDATION_VOLUME_MIN_BASELINE_VOLUME=5
RECOMMENDATION_VOLUME_DROP_RATIO=0.5
RECOMMENDATION_VOLUME_SPIKE_RATIO=2

# Dias evaluados seguidos sin recibir nada antes de avisar por persona. El
# silencio global puede ser cero y aun asi haber alguien olvidado.
RECOMMENDATION_USER_SILENCE_STREAK_DAYS=7

# UltraMsg (WhatsApp)
ULTRAMSG_INSTANCE_ID=<instance-id>
ULTRAMSG_TOKEN=<token>

# Webhook entrante de UltraMsg para feedback y ACK de entrega.
# Configura en UltraMsg una llamada POST a:
# https://ruralicos-api.onrender.com/webhooks/ultramsg/feedback?token=<este-token>
# Activa en la instancia `webhook_message_received` y `webhook_message_ack`.
ULTRAMSG_WEBHOOK_TOKEN=<token-secreto-webhook>

# Conciliacion de mensajes aceptados que aun no tienen ACK terminal.
ULTRAMSG_RECONCILE_ACCEPTED_MS=600000
ULTRAMSG_RECONCILE_SENT_MS=1800000
ULTRAMSG_RECONCILE_TIMEOUT_MS=15000

# Autenticación
JWT_SECRET=<clave-secreta-larga-y-aleatoria>

# Token para proteger rutas de cron
CRON_TOKEN=<token-secreto-cron>

# Opcional: pepper especifico para hashear codigos temporales de verificacion.
# Si no se define, se usa JWT_SECRET como fallback.
VERIFICATION_CODE_PEPPER=<pepper-largo-y-aleatorio>

# Compatibilidad temporal: permite CRON_TOKEN en query (?token=...) en produccion.
# Recomendado: false. Usa header x-cron-token o Authorization: Bearer.
ALLOW_CRON_TOKEN_QUERY=false

# Servidor (opcional, por defecto 3000)
PORT=3000

# Modo digest: si es 'true' (o no se define), desactiva el envío por alerta individual
# y obliga a usar el flujo preparar-digest + enviar-digest.
DIGEST_ONLY_MODE=true

# Preclasificacion barata previa a la IA: off | observe | hard_exclusions.
# Empezar siempre en observe y medir antes de activar descartes duros.
ALERT_PRECLASSIFIER_MODE=observe

# La validacion final es una defensa obligatoria del mensaje aprobado.
DIGEST_FINAL_VALIDATION_MODE=enforce

# Delay en ms entre mensajes digest para evitar bloqueos anti-spam (por defecto 3000)
DIGEST_DELAY_MS=3000

# Digest, resumen FREE, exploracion y respuestas MIA usan mia_outbox.
# El workflow diario la vacia por lotes; no programes otro cron para drenarla.
OUTBOX_MAX_LOOPS=50

# Reevalua a quien ya tiene un intento cerrado hoy. Sirve para reintentar el
# mismo dia tras corregir algo, sin desplegar una version de decision nueva.
# No puede duplicar mensajes: quien ya tiene digest enviado queda fuera igual.
PREPARAR_DIGEST_FORCE=false

# Preguntas selectivas de aprendizaje al final del workflow diario.
RUN_DAILY_EXPLORATION=true
MIA_MAX_PREGUNTAS_EXPLORACION_DIA=20
MIA_EXPLORACION_COOLDOWN_DIAS=30
# Un ACK tardio permite preguntar sobre el ultimo digest entregado en esta ventana.
MIA_EXPLORACION_DIGEST_WINDOW_DIAS=7
# Lease del postproceso de aprendizaje; tras un crash otro ACK puede reclamarlo.
MIA_LEARNING_POSTPROCESS_LEASE_MS=300000

# URL pública de la API (opcional, para generar enlaces)
PUBLIC_BASE_URL=https://ruralicos-api.onrender.com

# URL interna para autocalls del pipeline. Si no se define, el pipeline usa el
# host real de la peticion entrante. En Render puede fijarse al dominio onrender
# para no depender de un dominio custom/DNS.
# PIPELINE_INTERNAL_BASE_URL=https://ruralicos-api.onrender.com

# ─────────────────────────────────────────────
# Runner de pipeline con checkpoints (C1) — /tareas/pipeline-tick
# BLOQUE HISTORICO: no activar estas variables ni programar el endpoint.
# Se conserva solo para poder interpretar jobs y logs anteriores.
# ─────────────────────────────────────────────

# Produccion: false ejecuta el pipeline real y bloquea pipeline-diario para
# impedir duplicados. true deja un modo sombra util solo para diagnostico.
# RETIRADO: /tareas/pipeline-tick no es el cron de produccion.
# PIPELINE_TICK_SHADOW=false

# Presupuesto de tiempo por tick en ms, con margen frente al timeout de proxy:
# el tick para y hace checkpoint antes de agotarlo. (default 50000)
# PIPELINE_TICK_BUDGET_MS=50000

# Timeout duro por request HTTP del tick (ms). Sin esto, una fuente que no
# responde cuelga el tick hasta que Render lo mata a los ~55s SIN checkpoint
# (job huerfano). Un timeout se registra como error y no tumba el dia. (default 20000)
# PIPELINE_HTTP_TIMEOUT_MS=20000

# BOJA: reintentos acotados dentro del timeout HTTP del pipeline. El presupuesto
# total incluye calendario y boletín; los fines de semana no llama a la API.
# BOJA_TOTAL_BUDGET_MS=15000
# BOJA_HTTP_TIMEOUT_MS=7000
# BOJA_HTTP_ATTEMPTS=2
# BOJA_RETRY_BACKOFF_MS=300

# Reserva de presupuesto (ms): no se arranca una request nueva si no cabe entera
# antes del deadline. Por defecto coincide con PIPELINE_HTTP_TIMEOUT_MS para que
# ninguna llamada rebase el timeout de proxy de Render.
# PIPELINE_TICK_RESERVE_MS=20000

# Antiguedad del heartbeat (ms) tras la que otro tick puede robar un claim
# colgado, y por debajo de la cual reset NO reabre un running vivo. Debe ser
# MENOR que el intervalo del cron (10 min) para recuperar dentro de la ventana,
# y mayor que la duracion de un tick sano. (default 300000 = 5 min)
# PIPELINE_TICK_STALE_MS=300000

# Reintentos por fase antes de marcar el job como failed (el cron hace de
# backoff entre ticks). (default 3)
# PIPELINE_STAGE_MAX_ATTEMPTS=3

# Timeout del preflight (ms): antes de crear/reclamar el job, el tick comprueba
# que baseUrl/health responde. Si no, devuelve 503 preflight_failed sin tocar
# nada (evita el self-fetch colgado contra un host que acepta y no responde).
# (default 5000)
# PIPELINE_PREFLIGHT_TIMEOUT_MS=5000

# Variables antiguas del driver, sin uso en el comando cron vigente.
# PIPELINE_DRIVER_MAX_TICKS=60
# PIPELINE_DRIVER_DELAY_MS=1000
# Si otro tick conserva el claim, espera 10 s entre comprobaciones. Con 60
# intentos cubre los 5 min de caducidad sin bombardear la API ni el log.
# PIPELINE_DRIVER_BUSY_DELAY_MS=10000
# PIPELINE_DRIVER_BUDGET_MS=50000
# Variable antigua, sin uso:
# ALLOW_LEGACY_DIGEST_WORKFLOW=true

# Cron vigente: node scripts/run_digest_workflow.js (una vez al dia).
# Configurar en el servicio Cron Job de Render:
# BASE_URL=https://ruralicos-api.onrender.com
# HTTP_TIMEOUT_MS=900000
# HTTP_RETRIES=3
# HTTP_RETRY_DELAY_MS=5000
# MAX_LOOPS=40
# PREPARAR_DIGEST_MAX_LOOPS=200
# STEP_DELAY_MS=800
# RUN_SCRAPERS=true
# RUN_OFFICIAL_LISTS=true
# RUN_REPAIR=true

# BOPZ: dos dominios oficiales comparten un presupuesto duro menor que el
# timeout del pipeline. Los valores por defecto toleran portales lentos sin
# impedir que el resto de fuentes y los envios del dia continúen.
BOPZ_TOTAL_BUDGET_MS=14000
BOPZ_INDEX_TOTAL_BUDGET_MS=10000
BOPZ_HTML_TIMEOUT_MS=5000
BOPZ_HTML_ATTEMPTS=1

# ---------------------------------------------------------------------------
# Observabilidad (opcional)
# ---------------------------------------------------------------------------

# DSN de Sentry para captura de errores 5xx y crashes de proceso. Sin definir,
# la captura queda desactivada y @sentry/node ni se carga (local/tests).
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ---------------------------------------------------------------------------
# Retencion de datos (cumplimiento, ver docs/CUMPLIMIENTO.md)
# ---------------------------------------------------------------------------

# Interruptor del borrado real en /tareas/retencion-datos. Con false (default),
# el endpoint SOLO informa (dry-run) aunque se pida dry_run=false.
RETENTION_ENABLED=false
